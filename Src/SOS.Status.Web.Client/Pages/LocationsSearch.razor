@page "/locationsearch"
@inject IJSRuntime JsRuntime
@inject IObservationSearchService searchService
@inject ISnackbar Snackbar

<PageTitle>Locations search</PageTitle>

<MudStack Spacing="2">
    <MudText Typo="Typo.h4">Locations search</MudText>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="6">
            <div style="position: relative;">
                <div @ref="_mapContainer" style="height:560px; width:100%;"></div>
                <div @ref="_mapTooltip" class="map-hover-tooltip" role="tooltip" hidden></div>

                @if (isLoading)
                {
                    <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 20;">
                        <div style="width: 56px; height: 56px; border-radius: 8px; background: rgba(255, 255, 255, 0.86); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18); display: flex; align-items: center; justify-content: center;">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                        </div>
                    </div>
                }
            </div>

            <MudStack Row="true" Spacing="2" Class="mt-2 flex-wrap" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Outlined.Search"
                           Color="Color.Primary"
                           OnClick="OnSearchButtonClickedAsync"
                           Disabled="@IsSearchDisabled">
                    @if (isLoading)
                    {
                        <MudProgressCircular Color="Color.Inherit" Indeterminate="true" Size="Size.Small" Class="mr-2" />
                    }
                    <span>Sök</span>
                </MudButton>

                <MudCheckBox T="bool"
                             Value="@searchAutomaticallyWhenMapChanges"
                             ValueChanged="OnSearchAutomaticallyWhenMapChangesChanged"
                             Label="Sök automatiskt vid pan/zoom"
                             Color="Color.Primary"
                             Dense="true" />

                <MudCheckBox @bind-Value="cluster"
                             Label="Klustring"
                             Color="Color.Primary"
                             Dense="true" />

                <MudCheckBox @bind-Value="createSampleObservations"
                             Label="Exempelobs."
                             Color="Color.Primary"
                             Dense="true" />

                <MudCheckBox @bind-Value="useCache"
                             Label="Använd cache"
                             Color="Color.Primary"
                             Dense="true" />
            </MudStack>

            <MudPaper Class="pa-4 mt-2" Outlined="true">
                @if (selectedFeatures.Count == 0)
                {
                    <MudText Typo="Typo.body2">Inga features markerade.</MudText>
                }
                else
                {
                    <MudExpansionPanels MultiExpansion="true" Class="mt-2">
                        <MudExpansionPanel Text="@($"Antal träffade features: {selectedFeatures.Count}")" Expanded="true">
                            <ul class="selected-feature-hit-list">
                                <li>
                                    <strong>LocationIds:</strong>
                                    <div class="selected-feature-list-text">@selectedLocationIdsText</div>
                                </li>
                                <li>
                                    <strong>Lokaler:</strong>
                                    <div class="selected-feature-list-text">@selectedLocalitiesText</div>
                                </li>
                            </ul>
                        </MudExpansionPanel>

                        @if (selectedFeatures.FirstOrDefault() is { } firstSelectedFeature)
                        {
                            <MudExpansionPanel Text="@($"Första markerade feature: {firstSelectedFeature.FeatureId ?? "-"}")" Expanded="true">
                                @if (!firstSelectedFeature.HasProperties)
                                {
                                    <MudText Typo="Typo.body2" Class="mt-2">Inga properties hittades.</MudText>
                                }
                                else
                                {
                                    <pre class="selected-feature-json">@selectedFeatureJson</pre>
                                }
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                }
            </MudPaper>

        </MudItem>

        <MudItem xs="12" lg="6">
            <MudExpansionPanels MultiExpansion="false" Class="mb-2">
                <MudExpansionPanel Text="@ObservationPanelTitle" Expanded="true">
                    @if (selectedLocationIds.Count > 1)
                    {
                        <MudSelect T="ObservationLocationOption"
                                   Label="Lokal"
                                   Value="@selectedObservationLocation"
                                   ValueChanged="OnObservationLocationChangedAsync"
                                   ToStringFunc="@(option => option?.Label ?? string.Empty)"
                                   Placeholder="@AllObservationLocationsLabel"
                                   Clearable="true"
                                   Dense="true"
                                   Class="mb-2">
                            @foreach (var option in observationLocationOptions)
                            {
                                <MudSelectItem T="ObservationLocationOption" Value="@option">@option.Label</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    <div class="observation-preview-loading" role="status" aria-live="polite">
                        @if (isObservationPreviewLoading)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                                <MudText Typo="Typo.body2">@ObservationPreviewLoadingText</MudText>
                            </MudStack>
                        }
                    </div>
                    @if (observationSearchResult is null)
                    {
                        @if (!isObservationPreviewLoading)
                        {
                            <MudText Typo="Typo.body2">Sök för att visa de första @ObservationPreviewTake observationerna.</MudText>
                        }
                    }
                    else if (observationSearchResult.Records.Count == 0)
                    {
                        <MudText Typo="Typo.body2">Inga observationer hittades.</MudText>
                    }
                    else
                    {
                        @if (string.Equals(lastResultType, "geogrid", StringComparison.OrdinalIgnoreCase))
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
                                Kartresultatet är aggregerat till geogrid. Klicka på en gridruta för att zooma in.
                                Om automatisk sökning är avstängd, tryck på Sök efteråt för att kunna markera en lokal.
                            </MudAlert>
                        }

                        <div class="observations-table-container">
                            <MudTable T="Observation"
                                      Items="@observationSearchResult.Records"
                                      Dense="true"
                                      Hover="true"
                                      Bordered="true"
                                      Striped="true"
                                      Elevation="0">
                                <HeaderContent>
                                    <MudTh>Markera</MudTh>
                                    <MudTh>Svenskt namn</MudTh>
                                    <MudTh>Vetenskapligt namn</MudTh>
                                    <MudTh>Datum</MudTh>
                                    <MudTh>Lokal</MudTh>
                                    <MudTh>LocationId</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Markera">
                                        <MudCheckBox T="bool"
                                                     Value="@IsObservationHighlighted(context)"
                                                     ValueChanged="@((bool value) => OnObservationHighlightChangedAsync(context, value))"
                                                     Disabled="@(!CanHighlightObservation(context))"
                                                     Color="Color.Secondary"
                                                     Dense="true" />
                                    </MudTd>
                                    <MudTd DataLabel="Svenskt namn">@(context.Taxon?.VernacularName ?? "-")</MudTd>
                                    <MudTd DataLabel="Vetenskapligt namn">@(context.Taxon?.ScientificName ?? "-")</MudTd>
                                    <MudTd DataLabel="Datum">@(context.Event?.PlainStartDate ?? context.Event?.StartDate?.ToString("yyyy-MM-dd") ?? "-")</MudTd>
                                    <MudTd DataLabel="Lokal">@(context.Location?.Locality ?? "-")</MudTd>
                                    <MudTd DataLabel="LocationId" Class="observation-location-id">@(context.Location?.LocationId ?? "-")</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                    }
                </MudExpansionPanel>

                <MudExpansionPanel Text="Kartinfo">
                    <MudStack Spacing="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Class="mb-1">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@copyMapGeoJsonIcon"
                                       OnClick="CopyMapGeoJsonToClipboardAsync"
                                       Disabled="@string.IsNullOrWhiteSpace(mapGeoJson)">
                                Kopiera JSON
                            </MudButton>
                        </MudStack>
                        <MudText Typo="Typo.body2"><strong>Zoom:</strong> @currentZoomLevel.ToString("F2")</MudText>
                        <MudText Typo="Typo.body2"><strong>Meter per pixel:</strong> @currentMetersPerPixelText</MudText>
                        <MudText Typo="Typo.body2"><strong>BBox:</strong> @currentBboxText</MudText>
                        <MudText Typo="Typo.body2"><strong>Resultat:</strong> @lastResultTypeText</MudText>
                        <MudText Typo="Typo.body2"><strong>Använd strategi:</strong> @lastAdaptiveSearchStrategyText</MudText>
                        <MudText Typo="Typo.body2"><strong>Cache:</strong> @lastCacheStatusText</MudText>
                        <MudText Typo="Typo.body2"><strong>Antal observationer:</strong> @observationsTotalCountText</MudText>
                        <MudText Typo="Typo.body2"><strong>Estimerat antal lokaler:</strong> @estimatedLocationCountText</MudText>
                        <MudText Typo="Typo.body2"><strong>Lokaler före klustring:</strong> @locationsBeforeClusteringText</MudText>
                        <MudText Typo="Typo.body2"><strong>Gridrutor/lokaler:</strong> @mapFeatureCount</MudText>
                        <MudText Typo="Typo.body2"><strong>Svarsstorlek:</strong> @lastResponseSizeText</MudText>
                        <MudText Typo="Typo.body2"><strong>Söktid:</strong> @lastSearchDurationText</MudText>
                        <MudText Typo="Typo.body2"><strong>Servertider:</strong> @serverTimingsText</MudText>
                    </MudStack>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Sökning">
                    <MudStack Spacing="2">
                        <MudSelect T="int"
                                   @bind-Value="observationsLimit"
                                   Label="Observationsgräns"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   FullWidth="true">
                            @foreach (var option in adaptiveSearchLimitOptions)
                            {
                                <MudSelectItem T="int" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="int"
                                   @bind-Value="maxGridCells"
                                   Label="Max gridrutor"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   FullWidth="true">
                            @foreach (var option in adaptiveSearchLimitOptions)
                            {
                                <MudSelectItem T="int" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="int"
                                   @bind-Value="locationAggregationLimit"
                                   Label="Lokalaggregeringsgräns"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   FullWidth="true">
                            @foreach (var option in locationAggregationLimitOptions)
                            {
                                <MudSelectItem T="int" Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="AdaptiveSearchLocationsStrategy"
                                   @bind-Value="adaptiveSearchStrategy"
                                   Label="Strategi"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   FullWidth="true">
                            <MudSelectItem T="AdaptiveSearchLocationsStrategy" Value="@AdaptiveSearchLocationsStrategy.Auto">Auto</MudSelectItem>
                            <MudSelectItem T="AdaptiveSearchLocationsStrategy" Value="@AdaptiveSearchLocationsStrategy.ObservationsThenGrid">Observationer, grid</MudSelectItem>
                            <MudSelectItem T="AdaptiveSearchLocationsStrategy" Value="@AdaptiveSearchLocationsStrategy.ObservationsThenLocationsThenGrid">Observationer, lokaler, grid</MudSelectItem>
                            <MudSelectItem T="AdaptiveSearchLocationsStrategy" Value="@AdaptiveSearchLocationsStrategy.LocationsThenGrid">Lokaler, grid</MudSelectItem>
                        </MudSelect>

                        <MudNumericField T="int?"
                                         @bind-Value="cutoffYear"
                                         Label="Brytår"
                                         Placeholder="t.ex. 2024"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         FullWidth="true" />

                        <MudCheckBox @bind-Value="includeBoundingBoxInSearch"
                                     Label="Skicka med bbox"
                                     Color="Color.Primary"
                                     Dense="true" />

                        <MudSelect T="int"
                                   @bind-Value="bboxBufferPercent"
                                   Label="Bbox-buffer"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   Disabled="@(!includeBoundingBoxInSearch)"
                                   FullWidth="true">
                            @foreach (var option in bboxBufferPercentageOptions)
                            {
                                <MudSelectItem T="int" Value="@option">@($"{option} %")</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="CreatePolygonsMode"
                                   @bind-Value="createPolygonsMode"
                                   Label="Polygoner"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   FullWidth="true">
                            <MudSelectItem T="CreatePolygonsMode" Value="@CreatePolygonsMode.No">No</MudSelectItem>
                            <MudSelectItem T="CreatePolygonsMode" Value="@CreatePolygonsMode.WhenNeeded">WhenNeeded</MudSelectItem>
                            <MudSelectItem T="CreatePolygonsMode" Value="@CreatePolygonsMode.Yes">Yes</MudSelectItem>
                        </MudSelect>
                    </MudStack>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Klustring">
                    <MudStack Spacing="2">
                        <MudNumericField T="double?" @bind-Value="clusterRadiusMeters"
                                         Label="Fast sökradie (meter), tomt = av" Variant="Variant.Outlined"
                                         Margin="Margin.Dense" Min="0.01" FullWidth="true" />

                        <MudNumericField T="double"
                                         @bind-Value="clusterRadiusPx"
                                         Label="Fast sökradie för vanlig pixelklustring (px)"
                                         HelperText="Radien ökas inte för att minska antalet kartobjekt. Klustrets utbredning kan vara större."
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Disabled="@(!cluster)"
                                         Min="1.0"
                                         Max="500.0"
                                         Step="5.0"
                                         FullWidth="true" />

                        <MudNumericField T="int"
                                         @bind-Value="minLocationsPerCluster"
                                         Label="Min lokaler per kluster"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Disabled="@(!cluster && !clusterRadiusMeters.HasValue)"
                                         Min="2"
                                         Max="100"
                                         Step="1"
                                         FullWidth="true" />

                        <MudNumericField T="double"
                                         @bind-Value="switchToDetailClusteringAtMetersPerPixel"
                                         Label="Växla till detaljklustring vid ≤ (m/px)"
                                         HelperText="0 = ingen zoomväxling. Fast meterklustring påverkas inte."
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Disabled="@(!cluster)"
                                         Min="0.0"
                                         Step="0.1"
                                         FullWidth="true" />

                        <MudNumericField T="int"
                                         @bind-Value="minLocationCountBeforeClustering"
                                         Label="Min kartobjekt innan pixelklustring"
                                         HelperText="Gäller vanlig pixelklustring. Vid eller under antalsgränsen används detaljklustring."
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Disabled="@(!cluster)"
                                         Min="0"
                                         Max="10000"
                                         Step="10"
                                         FullWidth="true" />

                        <MudNumericField T="double"
                                         @bind-Value="detailClusterRadiusPx"
                                         Label="Fast sökradie för detaljklustring (px)"
                                         HelperText="Används när vanlig pixelklustring stoppas av zoom- eller antalsgränsen. 0 = detaljklustring av."
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Disabled="@(!cluster)"
                                         Min="0.0"
                                         Max="500.0"
                                         Step="0.5"
                                         FullWidth="true" />

                        <MudNumericField T="double?"
                                         Value="@compactClusterMaxRadiusMeters"
                                         ValueChanged="OnCompactClusterMaxRadiusMetersChanged"
                                         Label="Gräns för gul klustermarkering (meter)"
                                         HelperText="Tomt = av. Största avstånd från klustrets mittpunkt."
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0.0"
                                         Step="10.0"
                                         Clearable="true"
                                         Immediate="true"
                                         FullWidth="true" />
                    </MudStack>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Visning">
                    <MudStack Spacing="2">
                        <MudSelect T="PointSizeMode"
                                   Value="@pointSizeMode"
                                   ValueChanged="OnPointSizeModeChanged"
                                   Label="Punktstorlek"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   FullWidth="true">
                            <MudSelectItem T="PointSizeMode" Value="@PointSizeMode.Fixed">Fast storlek</MudSelectItem>
                            <MudSelectItem T="PointSizeMode" Value="@PointSizeMode.ByObservationCount">Efter antal – automatiska gränser</MudSelectItem>
                            <MudSelectItem T="PointSizeMode" Value="@PointSizeMode.ByObservationCountFixedBreaks">Efter antal – fasta gränser</MudSelectItem>
                        </MudSelect>

                        @if (ShowPointSizeLegend)
                        {
                            <div class="point-size-legend" aria-label="Punktstorlek efter observationsantal">
                                @foreach (var item in pointSizeLegend)
                                {
                                    <div class="point-size-legend-row">
                                        <span class="point-size-legend-symbol" aria-hidden="true">
                                            <span class="point-size-legend-dot" style="@($"width: {item.DiameterPx}px; height: {item.DiameterPx}px;")"></span>
                                        </span>
                                        <span>@item.CountText (@item.DiameterPx px)</span>
                                    </div>
                                }
                                @if (pointSizeMode == PointSizeMode.ByObservationCount)
                                {
                                    <MudText Typo="Typo.caption">Storlekarna är relativa till aktuellt resultat, med gränser vid 75:e och 90:e percentilen. Antalsgränserna kan ändras efter en ny sökning eller zoomning.</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption">Antalsgränserna är alltid 5 och 50, oberoende av sökning och zoom.</MudText>
                                }
                            </div>
                        }

                        <MudSelect T="HoverFeedbackMode"
                                   Value="@hoverFeedbackMode"
                                   ValueChanged="OnHoverFeedbackModeChanged"
                                   Label="Hovring"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   FullWidth="true"
                                   HelperText="Punkter visar noggrannhetsradie och kluster sin utbredning med röd kant och svagt gul fyllnad. Minsta ytan motsvarar punktsymbolen.">
                            <MudSelectItem T="HoverFeedbackMode" Value="@HoverFeedbackMode.Cursor">Visa annan muspekare när man hovrar över</MudSelectItem>
                            <MudSelectItem T="HoverFeedbackMode" Value="@HoverFeedbackMode.Outline">Samma muspekare men tillfällig röd kontur</MudSelectItem>
                            <MudSelectItem T="HoverFeedbackMode" Value="@HoverFeedbackMode.None">Inget</MudSelectItem>
                        </MudSelect>

                        <MudCheckBox T="bool"
                                     Value="@showMapTooltip"
                                     ValueChanged="OnShowMapTooltipChanged"
                                     Label="Visa tooltip vid hovring"
                                     Color="Color.Primary"
                                     Dense="true" />

                        <MudCheckBox T="bool"
                                     Value="@showCoordinateUncertaintyCircles"
                                     ValueChanged="OnShowCoordinateUncertaintyCirclesChanged"
                                     Label="Visa noggrannhetscirklar för visade lokaler"
                                     Color="Color.Primary"
                                     Dense="true" />

                        <MudCheckBox T="bool"
                                     Value="@showFilterAreaOutlines"
                                     ValueChanged="OnShowFilterAreaOutlinesChanged"
                                     Label="Visa sökfiltrets konturer"
                                     Color="Color.Primary"
                                     Dense="true" />

                        <MudCheckBox T="bool"
                                     Value="@showClusterRadiusCircles"
                                     ValueChanged="OnShowClusterRadiusCirclesChanged"
                                     Label="Visa klusterradie"
                                     Color="Color.Primary"
                                     Dense="true" />

                        <MudCheckBox T="bool"
                                     Value="@showClusterMinimumEnclosingCircles"
                                     ValueChanged="OnShowClusterMinimumEnclosingCirclesChanged"
                                     Label="Visa klusterinneslutning"
                                     Color="Color.Primary"
                                     Dense="true" />
                    </MudStack>
                </MudExpansionPanel>

                <MudExpansionPanel Text="JSON search filter">
                    <MudStack Spacing="2">
                        <MudSelect T="int?"
                                   Label="Load example"
                                   Variant="Variant.Outlined"
                                   Value="selectedExampleId"
                                   ValueChanged="LoadExample"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   FullWidth="true">
                            @foreach (var example in TaxonSearchFilterSamples.Samples)
                            {
                                <MudSelectItem T="int?" Value="@example.Key">@example.Value.Name</MudSelectItem>
                            }
                        </MudSelect>

                        <MudTextField @bind-Value="searchFilter"
                                      Placeholder="JSON search filter"
                                      Lines="10"
                                      FullWidth="true"
                                      Margin="Margin.Dense"
                                      Variant="Variant.Outlined" />
                    </MudStack>
                </MudExpansionPanel>

                <MudExpansionPanel Text="Teckenförklaring">
                    <MudStack Spacing="2">
                        <div class="map-legend-row">
                            <span class="map-legend-symbol map-legend-symbol--filter-area"></span>
                            <MudText Typo="Typo.body2">Sökfiltrets konturer</MudText>
                        </div>
                        @foreach (var section in MapLegendSections)
                        {
                            @if (section != MapLegendSections[0])
                            {
                                <MudDivider />
                            }
                            <MudText Typo="Typo.subtitle2">@section.Title</MudText>
                            <MudStack Spacing="1">
                                @foreach (var item in section.Items)
                                {
                                    <div class="map-legend-row">
                                        <span class="map-legend-symbol @section.SymbolClass" style="background: @item.Fill; border-color: @item.Border;"></span>
                                        <MudText Typo="Typo.body2">@item.Label</MudText>
                                    </div>
                                }
                            </MudStack>
                        }
                    </MudStack>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudItem>
    </MudGrid>
</MudStack>
