<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>SOS.Api.Client</PackageId>
    <Title>SOS API Client</Title>
    <Description>Typed .NET client and services for SOS Observations and Analysis API.</Description>
    <PackageTags>sos;api;observations;analysis;geojson</PackageTags>
    <Authors>SLU Artdatabanken</Authors>
    <Company>SLU Artdatabanken</Company>
    <PackageProjectUrl>https://github.com/biodiversitydata-se/SOS</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/biodiversitydata-se/SOS</RepositoryUrl>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <PackageVersion>0.1.0</PackageVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <EnablePackageValidation>true</EnablePackageValidation>
    <RootNamespace>SOS.Api.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SOS.Api.Contracts\SOS.Api.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="README.md" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
