{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.Extensions": "Warning",
        "ZiggyCreatures.Caching.Fusion": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ObservationApiConfiguration": {
    "CacheMonitoring": {
      "Enabled": true,
      "AdaptiveSearchLocationsLogEveryWriteCount": 100,
      "LocationGeometryLogEveryWriteCount": 50
    }
  },
  "SemaphoreLimitsConfiguration": {
    "Observation": {
      "Standard": 3,
      "Artfakta": 2,
      "Artportalen": 5,
      "Fynddata": 2,
      "Priority": 3,
      "ArtdataInternal": 2,
      "Unknown": 2
    },
    "Aggregation": {
      "Standard": 2,
      "Artfakta": 2,
      "Artportalen": 2,
      "Fynddata": 2,
      "Priority": 3,
      "ArtdataInternal": 2,
      "Unknown": 2
    }
  },
  "LocalHangfireDbConfiguration": {
    "Hosts": [
      {
        "Name": "localhost",
        "Port": 27017
      }
    ],
    "DatabaseName": "sos-hangfire",
    "UseTls": false,
    "JobExpirationDays": 1
  }
}
